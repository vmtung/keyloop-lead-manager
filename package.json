{
  "name": "keyloop-lead-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:(web|api)$/\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.ts",
    "simulate:lead": "node scripts/simulate-lead.ts",
    "reset-data": "node -e \"require('node:fs').rmSync('server/data',{recursive:true,force:true})\"",
    "test:e2e": "playwright test",
    "traces:up": "docker compose up -d jaeger",
    "traces:down": "docker compose down"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-fetch": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "1.53.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "web-vitals": "6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hono": "^4.13.13",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "description": "Sales Lead Management Tool (Keyloop technical assessment, Scenario C, Demand domain).",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  }
}
